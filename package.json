  "version": "0.1.0-rc.1",
  "type": "module",
  "scripts": {
    "assets:scout": "node scripts/build-scout-model.mjs",
    "assets:striker": "node scripts/build-striker-model.mjs",
    "assets:carrier": "node scripts/build-carrier-model.mjs",
    "assets:audio": "node scripts/build-audio-assets.mjs",
